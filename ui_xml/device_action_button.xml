<!-- One AMS device-action button, half of a device_action_button_row.
     AmsDeviceSectionDetailOverlay creates one per BUTTON action and names it
     after the action's id, which on_device_action_clicked reads back. -->
<component>
  <api>
    <prop name="text" type="string" default=""/>
    <prop name="icon" type="string" default=""/>
    <prop name="disabled" type="string" default="false"/>
    <prop name="moves_machine" type="string" default="false"/>
    <!-- An expression that disables the button, for motion gated more narrowly
         than moves_machine (one still allowed while the print is paused). -->
    <prop name="disabled_cond" type="string" default="0 eq 1"/>
  </api>
  <view extends="ui_button" text="$text" icon="$icon" flex_grow="1" disabled="$disabled" moves_machine="$moves_machine">
    <bind_state_if cond="$disabled_cond" state="disabled"/>
    <event_cb trigger="clicked" callback="on_device_action_clicked"/>
  </view>
</component>
