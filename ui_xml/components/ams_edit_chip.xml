<!-- One choice pill of the spool editor's chip rows (Material / Variant /
     Brand / Product). Same look as the LED chip: idle first, active after, the
     selected row subject naming the lit index. Label text and selection both
     arrive through subjects so a row rebuilds without touching widgets. -->
<component>
  <api>
    <prop name="index" type="string" default="0"/>
    <prop name="label_subject" type="string" default=""/>
    <prop name="selected_subject" type="string" default=""/>
    <prop name="callback" type="string" default=""/>
  </api>
  <view extends="ui_button"
        height="#led_chip_height" variant="ghost" style_radius="#led_chip_height" style_min_width="#led_chip_min_width"
        style_pad_left="#space_md" style_pad_right="#space_md" ext_click_area="#led_chip_gap_half">
    <!-- Idle first, active after: the later style wins while it is enabled. -->
    <style name="styles.chip_idle"/>
    <bind_style_if_eq name="styles.chip_active" subject="$selected_subject" ref_value="$index"/>
    <text_body bind_text="$label_subject" align="center" clickable="false" event_bubble="true"/>
    <event_cb trigger="clicked" callback="$callback" user_data="$index"/>
  </view>
</component>
