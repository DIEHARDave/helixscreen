<component>
  <!--
    One cell of the Controls Calibration & Tools grid: a home_action_tile sized
    by the grid's shape. ControlsPanel::update_calib_grid fits the visible
    cells to the grid's size (fit_tile_grid) and publishes calib_grid_columns,
    calib_grid_rows and calib_grid_labels; this cell turns those into its width,
    its height and whether its label shows. A visibility binding on an instance
    hides the whole cell, so the grid counts and packs only what is shown.
  -->
  <api>
    <prop name="icon" type="string" default="wrench"/>
    <prop name="label" type="string" default=""/>
    <prop name="callback" type="string" default=""/>
    <prop name="button_name" type="string" default="calib_tile_button"/>
    <prop name="icon_name" type="string" default="calib_tile_icon"/>
    <prop name="moves_machine" type="string" default="false"/>
    <prop name="disabled_cond" type="string" default="0 eq 1"/>
  </api>
  <styles>
    <!-- Percentages of the grid, leaving room for the gaps between cells -->
    <style name="calib_cols_1" width="100%"/>
    <style name="calib_cols_2" width="48%"/>
    <style name="calib_cols_3" width="31%"/>
    <style name="calib_cols_4" width="23%"/>
    <style name="calib_rows_1" height="100%"/>
    <style name="calib_rows_2" height="48%"/>
    <style name="calib_rows_3" height="31%"/>
    <style name="calib_rows_4" height="23%"/>
  </styles>
  <view extends="lv_obj" flex_grow="0" style_pad_all="0" scrollable="false">
    <style name="calib_cols_2"/>
    <bind_style_if_eq name="calib_cols_1" subject="calib_grid_columns" ref_value="1"/>
    <bind_style_if_eq name="calib_cols_3" subject="calib_grid_columns" ref_value="3"/>
    <bind_style_if_eq name="calib_cols_4" subject="calib_grid_columns" ref_value="4"/>
    <style name="calib_rows_2"/>
    <bind_style_if_eq name="calib_rows_1" subject="calib_grid_rows" ref_value="1"/>
    <bind_style_if_eq name="calib_rows_3" subject="calib_grid_rows" ref_value="3"/>
    <bind_style_if_eq name="calib_rows_4" subject="calib_grid_rows" ref_value="4"/>
    <home_action_tile width="100%"
                      height="100%" icon="$icon" icon_variant="text" icon_size="#calib_icon_size" label="$label"
                      callback="$callback" button_name="$button_name" icon_name="$icon_name"
                      label_hidden_cond="calib_grid_labels eq 0" moves_machine="$moves_machine"
                      disabled_cond="$disabled_cond"/>
  </view>
</component>
