<!-- One head's cell in the tool switcher rail, bound to the
     tool_switcher_seg_<index>_* subjects the widget publishes. The widget sizes
     every cell (tool_switcher_cell_w x _cell_h, never under the touch floor)
     and measures each label against the cell less #space_xs on each side, which
     is the padding the labels carry here. The rail clips the outer corners, so
     a segment is square.

     A tap on a head that is not mounted mounts it; a tap on the mounted head
     opens the sheet. Disabled while tool_switcher_change_blocked: a print that
     refuses the switch, or spools on the bed. Not moves_machine, which also
     holds through a pause, where a head change is offered behind its
     confirmation. -->
<component>
  <api>
    <prop name="index" type="string" default="0"/>
  </api>
  <styles>
    <!-- Not inline: an inline bg_color would outrank the bound mounted fill. -->
    <style name="seg_idle" bg_color="#elevated_bg" bg_opa="255"/>
    <style name="seg_mounted" bg_color="#primary"/>
    <style name="seg_mounted_text" text_color="#text_on_primary"/>
    <style name="seg_disabled" opa="50%"/>
  </styles>
  <view extends="lv_obj"
        flex_flow="column" style_flex_main_place="center" style_flex_cross_place="center"
        style_flex_track_place="center" style_pad_all="0" style_pad_gap="0" style_radius="0" style_border_width="0"
        clickable="true" scrollable="false">
    <bind_style_prop prop="width" subject="tool_switcher_cell_w"/>
    <bind_style_prop prop="height" subject="tool_switcher_cell_h"/>
    <style name="seg_idle"/>
    <style name="styles.press_wash" selector="pressed"/>
    <style name="seg_disabled" selector="disabled"/>
    <bind_style_if name="seg_mounted" cond="active_tool eq ${index}"/>
    <bind_state_if_eq subject="tool_switcher_change_blocked" state="disabled" ref_value="1"/>
    <text_body name="tool_switcher_seg_label"
               width="content" style_max_width="100%" style_pad_hor="#space_xs" long_mode="dots"
               bind_text="tool_switcher_seg_${index}_label" style_text_align="center" clickable="false"
               event_bubble="true">
      <bind_style_if name="seg_mounted_text" cond="active_tool eq ${index}"/>
    </text_body>
    <!-- "T0" under a full label, the temperature under a code label: a second
         line the widget shows only where the cell is tall and wide enough. -->
    <text_small name="tool_switcher_seg_sub"
                width="content" style_max_width="100%" style_pad_hor="#space_xs" long_mode="dots"
                bind_text="tool_switcher_seg_${index}_sub" style_text_align="center" clickable="false"
                event_bubble="true">
      <bind_flag_if_eq subject="tool_switcher_two_line" flag="hidden" ref_value="0"/>
      <bind_style_if name="seg_mounted_text" cond="active_tool eq ${index}"/>
    </text_small>
    <!-- The head's filament colour along the foot; omitted when unknown. -->
    <lv_obj name="tool_switcher_seg_strip"
            width="100%" align="bottom_mid" floating="true" style_radius="0" style_border_width="0" style_bg_opa="255"
            clickable="false" event_bubble="true" scrollable="false">
      <bind_style_prop prop="height" subject="tool_switcher_strip_h"/>
      <bind_style_prop prop="bg_color" subject="tool_switcher_seg_${index}_color"/>
      <bind_flag_if_eq subject="tool_switcher_seg_${index}_has_color" flag="hidden" ref_value="0"/>
    </lv_obj>
    <event_cb trigger="clicked" callback="tool_switcher_segment_cb" user_data="$index"/>
  </view>
</component>
