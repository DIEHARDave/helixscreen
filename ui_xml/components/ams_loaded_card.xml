<component>
  <!--
    AMS Currently Loaded Strip - what is loaded, and its clog/buffer meters.

    A color bar beside two lines: "Current: Gate 1" with the remaining weight,
    then the filament's name, one line, ellipsized. The meters follow while the
    unit is idle and hide during any operation (ams_action), so the step progress
    gets the room.

    Binds to AmsState subjects:
    - ams_current_slot_text: the loaded position ("Current: Gate 1")
    - ams_current_material_text: the filament's name (e.g., "Red PLA")
    - ams_current_weight_text / ams_current_has_weight: remaining weight
    - clog_meter_mode: 0=hidden, 1=encoder, 2=flowguard, 3=afc_buffer
    - clog_meter_center_text / clog_meter_mode_text: the reading and its source
    - buffer_present / buffer_slider / buffer_short_text / buffer_label: the
      filament buffer, drawn by UiBufferSlider into buffer_mini_slider

    The meters sit under the lines (not at all on a narrow portrait screen, which
    has no height for them). In landscape from the medium breakpoint up they keep
    their full form (arc over reading over source; slider over reading over
    label); below it, and in portrait, they are one small row: a small arc beside
    its reading, the buffer icon beside its reading.

    Color swatch updated by C++ via lv_obj_find_by_name(sidebar, "loaded_swatch").
    Clog arc size/stroke/color dynamically set by UiClogMeter C++ class via
    SIZE_CHANGED callback — no fixed pixel sizes in XML.
  -->
  <styles>
    <style name="meter_column"
           layout="flex" flex_flow="column" flex_main_place="center" flex_cross_place="center" pad_column="0"/>
    <style name="meter_row"
           layout="flex" flex_flow="row" flex_main_place="center" flex_cross_place="center" pad_column="#space_xxs"/>
  </styles>
  <view name="ams_loaded_card"
        extends="ui_card" width="100%" height="content" style_radius="#border_radius" style_bg_color="#elevated_bg"
        style_pad_all="#space_xs" flex_flow="row" style_flex_main_place="start" style_flex_cross_place="center"
        style_pad_gap="#space_sm">
    <!-- Color bar (left side, stretches to the strip's height) -->
    <lv_obj name="loaded_swatch"
            width="#loaded_swatch_narrow_w" height="100%" style_radius="#border_radius" style_bg_color="#text_muted"
            style_bg_opa="255" style_border_width="#space_xxs" style_border_color="#text_muted" style_border_opa="80"
            scrollable="false" clickable="false"/>
    <!-- Body: the two lines across the full width, the meters wrapping below -->
    <lv_obj name="loaded_body"
            width="1" height="content" flex_grow="1" style_pad_all="0" style_pad_column="#space_sm"
            style_pad_row="#space_xxs" flex_flow="row_wrap" style_flex_main_place="start"
            style_flex_cross_place="center" style_flex_track_place="start" scrollable="false">
      <lv_obj name="loaded_details"
              width="100%" height="content" style_pad_all="0" flex_flow="column" style_flex_main_place="center"
              style_flex_cross_place="start" style_pad_gap="0" scrollable="false">
        <!-- Line 1: where it is loaded from, and how much is left -->
        <lv_obj name="loaded_position_row"
                width="100%" height="content" style_pad_all="0" flex_flow="row" style_flex_cross_place="center"
                style_pad_gap="#space_xs" scrollable="false">
          <text_small name="loaded_position"
                      width="1" height="#ams_loaded_name_line_h" flex_grow="1" bind_text="ams_current_slot_text"
                      long_mode="dots"/>
          <text_tiny name="loaded_weight" bind_text="ams_current_weight_text" style_text_color="#text_muted">
            <bind_flag_if_eq subject="ams_current_has_weight" flag="hidden" ref_value="0"/>
          </text_tiny>
        </lv_obj>
        <!-- Line 2: the filament's name, one line, ellipsized -->
        <text_small name="loaded_material"
                    width="100%" height="#ams_loaded_name_line_h" bind_text="ams_current_material_text" long_mode="dots"
                    style_text_color="#text_muted"/>
      </lv_obj>
      <!-- Clog detection meter: hidden with no source, and during any operation.
           Arc size set dynamically by UiClogMeter C++ SIZE_CHANGED callback. -->
      <lv_obj name="clog_meter" width="content" height="content" style_pad_all="0" scrollable="false" style_pad_row="0">
        <bind_flag_if cond="clog_meter_mode eq 0 or ams_action ne 0 or (ui_is_portrait eq 1 and ui_breakpoint lt 3)"
                      flag="hidden"/>
        <bind_style_if name="meter_column" cond="ui_is_portrait eq 0 and ui_breakpoint ge 3"/>
        <bind_style_if name="meter_row" cond="ui_is_portrait eq 1 or ui_breakpoint lt 3"/>
        <!-- Mini arc (sized by C++) -->
        <lv_obj name="clog_arc_container" style_pad_all="0" scrollable="false">
          <!-- Main arc: helix_progress_arc handles common styling and the
               diameter-driven stroke tier. UiClogMeter syncs the danger/peak
               overlay arcs (created in C++) to match. -->
          <helix_progress_arc name="clog_arc" align="center"/>
          <!-- Stands in for the arc when there is nothing to report. UiClogMeter
               swaps the two, finding this by name under its parent. -->
          <lv_label name="clog_safe_icon"
                    hidden="true" align="center" text="#icon_check_circle" style_text_font="mdi_icons_16"
                    style_text_color="#primary" clickable="false"/>
        </lv_obj>
        <!-- The reading sits beside or under the arc rather than inside it: the arc
             is sized off the card width and lands around 36px, which "11.8mm" does
             not fit in. -->
        <text_tiny name="clog_value_text" bind_text="clog_meter_center_text" style_text_align="center"/>
        <text_tiny name="clog_mode_text"
                   width="100%" bind_text="clog_meter_mode_text" style_text_color="#text_muted"
                   style_text_align="center" long_mode="wrap">
          <bind_flag_if cond="ui_breakpoint lt 3 or ui_is_portrait eq 1" flag="hidden"/>
        </text_tiny>
      </lv_obj>
      <!-- Filament buffer meter: hidden without a reading, and during any
           operation. From medium up the slider shows when there is a set point to
           centre on; below medium the buffer icon stands in for it. The number is
           the short form, so the meter stays narrow. -->
      <lv_obj name="buffer_mini" width="content" height="content" style_pad_all="0" scrollable="false" style_pad_row="0">
        <bind_flag_if cond="buffer_present eq 0 or ams_action ne 0 or (ui_is_portrait eq 1 and ui_breakpoint lt 3)"
                      flag="hidden"/>
        <bind_style_if name="meter_column" cond="ui_is_portrait eq 0 and ui_breakpoint ge 3"/>
        <bind_style_if name="meter_row" cond="ui_is_portrait eq 1 or ui_breakpoint lt 3"/>
        <icon src="swap_vertical" size="xs" variant="secondary" clickable="false">
          <bind_flag_if cond="ui_breakpoint ge 3 and ui_is_portrait eq 0" flag="hidden"/>
        </icon>
        <lv_obj name="buffer_mini_slider"
                width="#buffer_slider_w" height="#buffer_mini_h" style_pad_all="0" scrollable="false" clickable="false">
          <bind_flag_if cond="buffer_slider eq 0 or ui_breakpoint lt 3 or ui_is_portrait eq 1" flag="hidden"/>
        </lv_obj>
        <text_tiny name="buffer_mini_value"
                   width="content" bind_text="buffer_short_text" style_text_align="center" long_mode="wrap">
          <bind_style_if_eq name="styles.buffer_ok" subject="buffer_status" ref_value="0"/>
          <bind_style_if_eq name="styles.buffer_warning" subject="buffer_status" ref_value="1"/>
          <bind_style_if_eq name="styles.buffer_danger" subject="buffer_status" ref_value="2"/>
        </text_tiny>
        <text_tiny name="buffer_mini_label"
                   width="content" bind_text="buffer_label" style_text_color="#text_muted" style_text_align="center">
          <bind_flag_if cond="ui_breakpoint lt 3 or ui_is_portrait eq 1" flag="hidden"/>
        </text_tiny>
      </lv_obj>
    </lv_obj>
  </view>
</component>
