<component>
  <!-- Axis Rows layout: one row per axis, the axis key in the middle (it homes
       that axis, solid while the axis still needs homing) between minus keys
       on the left and plus keys on the right, at the jog mode's outer and
       inner distances. Home All and leveling sit above, the jog modes below.
       The Z row's arrows carry the kinematics-aware icons and limit states of
       the pad layout's Z column, and follow its bed_moves inversion. Portrait
       rows are narrow and tall, so the jog keys stack their icon over the
       distance there. -->
  <view name="motion_jog_rows"
        extends="lv_obj" width="100%" height="100%" style_pad_all="0" style_border_opa="0" style_bg_opa="0"
        scrollable="false" flex_flow="column" style_pad_gap="#space_xs">
    <lv_obj name="rows_top"
            width="100%" height="0" flex_grow="1" style_pad_all="0" style_border_opa="0" style_bg_opa="0"
            scrollable="false" flex_flow="row" style_pad_gap="#space_xs">
      <ui_button name="rows_home_all"
                 width="0" height="100%" flex_grow="1" style_min_width="0" icon="home" text="All" moves_machine="true">
        <bind_style_if name="styles.choice_selected"
                       cond="motion_x_homed eq 0 or motion_y_homed eq 0 or motion_z_homed eq 0"/>
        <bind_style_if name="styles.choice_idle"
                       cond="motion_x_homed eq 1 and motion_y_homed eq 1 and motion_z_homed eq 1"/>
        <event_cb trigger="clicked" callback="on_motion_home" user_data="all"/>
      </ui_button>
      <motion_leveling_row name="rows_leveling" width="0" height="100%" flex_grow="2"/>
    </lv_obj>
    <lv_obj name="rows_x"
            width="100%" height="0" flex_grow="1" style_pad_all="0" style_border_opa="0" style_bg_opa="0"
            scrollable="false" flex_flow="row" style_pad_gap="#space_xs">
      <motion_jog_button name="rows_x_minus_large"
                         width="0" height="100%" jog="x_minus_large" stacked_subject="ui_is_portrait" stacked_if_eq="1"
                         style_pad_hor="#space_xxs" flex_grow="2" icon="arrow_left" label="motion_jog_outer_label"
                         variant="secondary"/>
      <motion_jog_button name="rows_x_minus_small"
                         width="0" height="100%" jog="x_minus_small" stacked_subject="ui_is_portrait" stacked_if_eq="1"
                         style_pad_hor="#space_xxs" flex_grow="2" icon="arrow_left" label="motion_jog_inner_label"
                         variant="secondary"/>
      <ui_button name="rows_home_x"
                 width="0" height="100%" flex_grow="1" style_min_width="0" text="X" moves_machine="true">
        <bind_style name="styles.choice_selected" subject="motion_x_homed" ref_value="0"/>
        <bind_style name="styles.choice_idle" subject="motion_x_homed" ref_value="1"/>
        <event_cb trigger="clicked" callback="on_motion_home" user_data="X"/>
      </ui_button>
      <motion_jog_button name="rows_x_plus_small"
                         width="0" height="100%" jog="x_plus_small" stacked_subject="ui_is_portrait" stacked_if_eq="1"
                         style_pad_hor="#space_xxs" flex_grow="2" icon="arrow_right" label="motion_jog_inner_label"
                         variant="secondary"/>
      <motion_jog_button name="rows_x_plus_large"
                         width="0" height="100%" jog="x_plus_large" stacked_subject="ui_is_portrait" stacked_if_eq="1"
                         style_pad_hor="#space_xxs" flex_grow="2" icon="arrow_right" label="motion_jog_outer_label"
                         variant="secondary"/>
    </lv_obj>
    <lv_obj name="rows_y"
            width="100%" height="0" flex_grow="1" style_pad_all="0" style_border_opa="0" style_bg_opa="0"
            scrollable="false" flex_flow="row" style_pad_gap="#space_xs">
      <motion_jog_button name="rows_y_minus_large"
                         width="0" height="100%" jog="y_minus_large" stacked_subject="ui_is_portrait" stacked_if_eq="1"
                         style_pad_hor="#space_xxs" flex_grow="2" icon="arrow_down" label="motion_jog_outer_label"
                         variant="secondary"/>
      <motion_jog_button name="rows_y_minus_small"
                         width="0" height="100%" jog="y_minus_small" stacked_subject="ui_is_portrait" stacked_if_eq="1"
                         style_pad_hor="#space_xxs" flex_grow="2" icon="arrow_down" label="motion_jog_inner_label"
                         variant="secondary"/>
      <ui_button name="rows_home_y"
                 width="0" height="100%" flex_grow="1" style_min_width="0" text="Y" moves_machine="true">
        <bind_style name="styles.choice_selected" subject="motion_y_homed" ref_value="0"/>
        <bind_style name="styles.choice_idle" subject="motion_y_homed" ref_value="1"/>
        <event_cb trigger="clicked" callback="on_motion_home" user_data="Y"/>
      </ui_button>
      <motion_jog_button name="rows_y_plus_small"
                         width="0" height="100%" jog="y_plus_small" stacked_subject="ui_is_portrait" stacked_if_eq="1"
                         style_pad_hor="#space_xxs" flex_grow="2" icon="arrow_up" label="motion_jog_inner_label"
                         variant="secondary"/>
      <motion_jog_button name="rows_y_plus_large"
                         width="0" height="100%" jog="y_plus_large" stacked_subject="ui_is_portrait" stacked_if_eq="1"
                         style_pad_hor="#space_xxs" flex_grow="2" icon="arrow_up" label="motion_jog_outer_label"
                         variant="secondary"/>
    </lv_obj>
    <lv_obj name="rows_z"
            width="100%" height="0" flex_grow="1" style_pad_all="0" style_border_opa="0" style_bg_opa="0"
            scrollable="false" flex_flow="row" style_pad_gap="#space_xs">
      <motion_jog_button name="rows_z_down_large"
                         width="0" height="100%" jog="z_down_large" stacked_subject="ui_is_portrait" stacked_if_eq="1"
                         style_pad_hor="#space_xxs" flex_grow="2" icon="arrow_down" bind_icon="motion_z_down_icon"
                         label="motion_jog_outer_label" variant="secondary">
        <bind_state_if_eq subject="motion_z_down_blocked" state="disabled" ref_value="1"/>
      </motion_jog_button>
      <motion_jog_button name="rows_z_down_small"
                         width="0" height="100%" jog="z_down_small" stacked_subject="ui_is_portrait" stacked_if_eq="1"
                         style_pad_hor="#space_xxs" flex_grow="2" icon="arrow_down" bind_icon="motion_z_down_icon"
                         label="motion_jog_inner_label" variant="secondary">
        <bind_state_if_eq subject="motion_z_down_blocked" state="disabled" ref_value="1"/>
      </motion_jog_button>
      <ui_button name="rows_home_z"
                 width="0" height="100%" flex_grow="1" style_min_width="0" text="Z" moves_machine="true">
        <bind_style name="styles.choice_selected" subject="motion_z_homed" ref_value="0"/>
        <bind_style name="styles.choice_idle" subject="motion_z_homed" ref_value="1"/>
        <event_cb trigger="clicked" callback="on_motion_home" user_data="Z"/>
      </ui_button>
      <motion_jog_button name="rows_z_up_small"
                         width="0" height="100%" jog="z_up_small" stacked_subject="ui_is_portrait" stacked_if_eq="1"
                         style_pad_hor="#space_xxs" flex_grow="2" icon="arrow_up" bind_icon="motion_z_up_icon"
                         label="motion_jog_inner_label" variant="secondary">
        <bind_state_if_eq subject="motion_z_up_blocked" state="disabled" ref_value="1"/>
      </motion_jog_button>
      <motion_jog_button name="rows_z_up_large"
                         width="0" height="100%" jog="z_up_large" stacked_subject="ui_is_portrait" stacked_if_eq="1"
                         style_pad_hor="#space_xxs" flex_grow="2" icon="arrow_up" bind_icon="motion_z_up_icon"
                         label="motion_jog_outer_label" variant="secondary">
        <bind_state_if_eq subject="motion_z_up_blocked" state="disabled" ref_value="1"/>
      </motion_jog_button>
    </lv_obj>
    <lv_obj name="rows_modes"
            width="100%" height="0" flex_grow="1" style_pad_all="0" style_border_opa="0" style_bg_opa="0"
            scrollable="false" flex_flow="row" style_pad_gap="#space_xs">
      <ui_button name="rows_mode_fine"
                 width="0" height="100%" flex_grow="1" style_min_width="0" text="Fine" icon="tortoise">
        <bind_style name="styles.choice_selected" subject="motion_jog_mode_fine_active" ref_value="1"/>
        <bind_style name="styles.choice_idle" subject="motion_jog_mode_fine_active" ref_value="0"/>
        <event_cb trigger="clicked" callback="on_jog_mode_fine"/>
      </ui_button>
      <ui_button name="rows_mode_coarse"
                 width="0" height="100%" flex_grow="1" style_min_width="0" text="Coarse" icon="rabbit">
        <bind_style name="styles.choice_selected" subject="motion_jog_mode_coarse_active" ref_value="1"/>
        <bind_style name="styles.choice_idle" subject="motion_jog_mode_coarse_active" ref_value="0"/>
        <event_cb trigger="clicked" callback="on_jog_mode_coarse"/>
      </ui_button>
      <ui_button name="rows_mode_turbo"
                 width="0" height="100%" flex_grow="1" style_min_width="0" text="Turbo" icon="flash">
        <bind_style name="styles.choice_selected" subject="motion_jog_mode_turbo_active" ref_value="1"/>
        <bind_style name="styles.choice_idle" subject="motion_jog_mode_turbo_active" ref_value="0"/>
        <event_cb trigger="clicked" callback="on_jog_mode_turbo"/>
      </ui_button>
    </lv_obj>
  </view>
</component>
