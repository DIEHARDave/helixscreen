<component>
  <!--
    AMS Environment Indicator - Compact display for temperature and humidity.

    A column on the overview's unit cards; a one-line chip on the lid of the
    box inside ams_unit_detail.
    Two display modes:
    - Passive: thermometer icon + temp, water icon + humidity (stacked vertically)
    - Drying:  heat_wave icon + drying status text (stacked vertically)

    Hidden when no environment data exists. Clickable to open environment overlay.

    Parameterized by 7 type="subject" <api> props (see below), so each overview
    card / detail view can bind its own per-unit subject set. Callers pass the
    expanded ams_env_ind_<i>_* (overview) or ams_env_ind_detail_* (detail) names;
    the defaults below (unit 0) apply when a prop is omitted.
    - $temp_text:        formatted temp ("24C")
    - $humidity_text:    formatted humidity ("46%")
    - $humidity_status:  0=ok(green), 1=warn(yellow), 2=danger(red)
    - $humidity_visible: 1 when a humidity reading exists
    - $visible:          1 when environment data available
    - $drying_active:    1 when drying in progress
    - $drying_text:      "47C > 55C  2:30"

    Callback:
    - on_env_indicator_clicked: opens the environment overlay for the badge's unit
      (unit index read from the widget's user_data by the C++ handler)
  -->
  <api>
    <prop name="temp_text" type="subject" default="ams_env_ind_0_temp_text"/>
    <prop name="humidity_text" type="subject" default="ams_env_ind_0_humidity_text"/>
    <prop name="humidity_status" type="subject" default="ams_env_ind_0_humidity_status"/>
    <prop name="humidity_visible" type="subject" default="ams_env_ind_0_humidity_visible"/>
    <prop name="visible" type="subject" default="ams_env_ind_0_visible"/>
    <prop name="drying_active" type="subject" default="ams_env_ind_0_drying_active"/>
    <prop name="drying_text" type="subject" default="ams_env_ind_0_drying_text"/>
    <!-- Below breakpoint $stack_below the readings stack in a column; from it up they
         lie in one row. The default (past the largest breakpoint) always stacks: a
         card's side column. -->
    <prop name="stack_below" type="string" default="7"/>
    <!-- Below breakpoint $icons_below the readings drop their icons (text only). -->
    <prop name="icons_below" type="string" default="0"/>
    <prop name="chip_bg_opa" type="string" default="140"/>
  </api>
  <styles>
    <style name="flow_row" layout="flex" flex_flow="row"/>
    <style name="flow_stack" layout="flex" flex_flow="column"/>
  </styles>
  <view name="ams_environment_indicator"
        extends="lv_obj" width="content" height="content" style_margin_top="#space_xs" style_pad_top="#space_xs"
        style_pad_bottom="#space_xs" style_pad_left="#space_xxs" style_pad_right="#space_xxs"
        style_flex_main_place="center" style_flex_cross_place="center" style_pad_gap="#space_xxs" scrollable="false"
        clickable="true" style_bg_opa="$chip_bg_opa" style_bg_color="#screen_bg" style_radius="4" hidden="true">
    <style name="styles.press_wash" selector="pressed"/>
    <bind_style_if_ge name="flow_row" subject="ui_breakpoint" ref_value="$stack_below"/>
    <bind_style_if_lt name="flow_stack" subject="ui_breakpoint" ref_value="$stack_below"/>
    <bind_flag_if_eq subject="$visible" flag="hidden" ref_value="0"/>
    <event_cb trigger="clicked" callback="on_env_indicator_clicked"/>

    <!-- Passive mode: temp + humidity, stacked or in one row per $stack_below -->
    <lv_obj width="content"
            height="content" style_pad_all="0" style_flex_main_place="center" style_flex_cross_place="center"
            style_pad_gap="#space_xxs" scrollable="false" clickable="false" event_bubble="true">
      <bind_style_if_ge name="flow_row" subject="ui_breakpoint" ref_value="$stack_below"/>
      <bind_style_if_lt name="flow_stack" subject="ui_breakpoint" ref_value="$stack_below"/>
      <bind_flag_if_not_eq subject="$drying_active" flag="hidden" ref_value="0"/>

      <!-- Temperature row -->
      <lv_obj width="content"
              height="content" style_pad_all="0" flex_flow="row" style_flex_main_place="center"
              style_flex_cross_place="center" style_pad_gap="#space_xxs" scrollable="false" clickable="false"
              event_bubble="true">
        <icon src="thermometer" size="sm" variant="secondary" clickable="false" event_bubble="true">
          <bind_flag_if_lt subject="ui_breakpoint" flag="hidden" ref_value="$icons_below"/>
        </icon>
        <text_small bind_text="$temp_text" clickable="false" event_bubble="true"/>
      </lv_obj>

      <!-- Humidity row (color-coded by material comfort range) -->
      <lv_obj width="content"
              height="content" style_pad_all="0" flex_flow="row" style_flex_main_place="center"
              style_flex_cross_place="center" style_pad_gap="#space_xxs" scrollable="false" clickable="false"
              event_bubble="true" hidden="true">
        <bind_flag_if_not_eq subject="$humidity_visible" flag="hidden" ref_value="1"/>
        <icon src="water" size="sm" variant="secondary" clickable="false" event_bubble="true">
          <bind_flag_if_lt subject="ui_breakpoint" flag="hidden" ref_value="$icons_below"/>
        </icon>
        <!-- OK (green/default) — visible when status=0 -->
        <text_small bind_text="$humidity_text" clickable="false" event_bubble="true" hidden="true">
          <bind_flag_if_not_eq subject="$humidity_status" flag="hidden" ref_value="0"/>
        </text_small>
        <!-- Warning (yellow) — visible when status=1 -->
        <text_small bind_text="$humidity_text"
                    style_text_color="#warning" clickable="false" event_bubble="true" hidden="true">
          <bind_flag_if_not_eq subject="$humidity_status" flag="hidden" ref_value="1"/>
        </text_small>
        <!-- Danger (red) — visible when status=2 -->
        <text_small bind_text="$humidity_text"
                    style_text_color="#danger" clickable="false" event_bubble="true" hidden="true">
          <bind_flag_if_not_eq subject="$humidity_status" flag="hidden" ref_value="2"/>
        </text_small>
      </lv_obj>
    </lv_obj>

    <!-- Drying mode: heat icon + status text, stacked or in one row per $stack_below -->
    <lv_obj width="content"
            height="content" style_pad_all="0" style_flex_main_place="center" style_flex_cross_place="center"
            style_pad_gap="#space_xxs" scrollable="false" clickable="false" event_bubble="true">
      <bind_style_if_ge name="flow_row" subject="ui_breakpoint" ref_value="$stack_below"/>
      <bind_style_if_lt name="flow_stack" subject="ui_breakpoint" ref_value="$stack_below"/>
      <bind_flag_if_eq subject="$drying_active" flag="hidden" ref_value="0"/>
      <icon src="heat_wave" size="sm" variant="warning" clickable="false" event_bubble="true">
        <bind_flag_if_lt subject="ui_breakpoint" flag="hidden" ref_value="$icons_below"/>
      </icon>
      <text_small bind_text="$drying_text"
                  style_text_color="#warning" style_text_align="center" clickable="false" event_bubble="true"/>
    </lv_obj>
  </view>
</component>
