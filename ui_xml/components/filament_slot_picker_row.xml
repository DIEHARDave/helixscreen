<component>
  <!-- One row in the filament slot picker popup: color swatch, slot label,
       optional material-mismatch warning. Colors, label text, warn
       visibility, and selected-state styling are set from C++. Sizes,
       padding, fonts, and radius live here so the row can be tuned without
       rebuilding. -->
  <view name="row"
        extends="lv_obj" width="100%" height="content" flex_flow="row" style_flex_cross_place="center"
        style_pad_all="#space_md" style_pad_gap="#space_md" style_radius="#space_sm" scrollable="false" clickable="true">
    <style name="styles.press_wash" selector="pressed"/>
    <!-- The slot's colour (painted from C++ for a loaded slot; an empty slot
         shows only a warning ring, also from C++). -->
    <color_dot name="swatch" size="#space_2xl"/>
    <!-- Slot description ("Turtle 1 · Slot 2: PLA"). -->
    <text_body name="slot_label" flex_grow="1" text="" long_mode="dots" clickable="false" event_bubble="true"/>
    <!-- Material-mismatch warning (shown only when the slot's material
         differs from the file's expected material). -->
    <lv_label name="warn_icon"
              hidden="true" text="#icon_triangle_exclamation" style_text_font="mdi_icons_16" style_text_color="#warning"
              clickable="false" event_bubble="true"/>
  </view>
</component>
