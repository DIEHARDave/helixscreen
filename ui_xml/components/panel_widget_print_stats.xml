<component>
  <!--
    Print stats home tile. PrintStatsWidget publishes print_stats_rung (SizeRung),
    print_stats_content (0 loading, 1 no history, 2 activity), print_stats_support
    (0 none, 1 prints only, 2 full), the show/side-by-side flags, the hero and support
    texts, and seven day bars with their weekday initials; everything below binds off
    them. A tap opens the history dashboard.

    Rungs: 1 strip (this week's hours and its label on one line), 3 cell (plus the seven bars and the
    lifetime print count), 4 wide (the bars beside the hours, and the lifetime line with
    hours and filament), 5 full (wide stacked, plus weekday initials under the bars).
  -->
  <styles>
    <style name="ps_main_column"
           layout="flex" flex_flow="column" flex_main_place="start" flex_cross_place="start" flex_track_place="start"/>
    <style name="ps_main_row"
           layout="flex" flex_flow="row" flex_main_place="start" flex_cross_place="center" flex_track_place="center"/>
    <style name="ps_hero_inline"
           width="100%" layout="flex" flex_flow="row" flex_main_place="start" flex_cross_place="end"
           flex_track_place="start"/>
    <style name="ps_hero_stacked"
           width="content" layout="flex" flex_flow="column" flex_main_place="start" flex_cross_place="start"
           flex_track_place="start"/>
  </styles>
  <view name="panel_widget_print_stats"
        extends="lv_obj" width="100%" height="100%" style_pad_all="#space_xxs" style_pad_row="#space_xxs"
        style_pad_column="0" scrollable="false" flex_flow="column" style_flex_main_place="start"
        style_flex_cross_place="start">
    <event_cb trigger="clicked" callback="print_stats_clicked_cb"/>
    <style name="styles.press_wash" selector="pressed"/>

    <lv_obj name="ps_main"
            width="100%" flex_grow="1" style_pad_all="0" style_pad_row="#space_xxs" style_pad_column="#space_xs"
            style_bg_opa="0" style_border_width="0" scrollable="false" clickable="false" event_bubble="true">
      <bind_style_if_eq name="ps_main_row" subject="print_stats_side_by_side" ref_value="1"/>
      <bind_style_if_eq name="ps_main_column" subject="print_stats_side_by_side" ref_value="0"/>

      <lv_obj name="ps_hero_block"
              height="content" style_pad_all="0" style_pad_row="0" style_pad_column="#space_xs" style_bg_opa="0"
              style_border_width="0" scrollable="false" clickable="false" event_bubble="true">
        <bind_style_if_eq name="ps_hero_inline" subject="print_stats_rung" ref_value="1"/>
        <bind_style_if_not_eq name="ps_hero_stacked" subject="print_stats_rung" ref_value="1"/>
        <text_heading name="ps_hero" bind_text="print_stats_hero" clickable="false" event_bubble="true">
          <bind_flag_if_eq subject="print_stats_content" flag="hidden" ref_value="1"/>
        </text_heading>
        <text_small name="ps_hero_label"
                    flex_grow="1" bind_text="print_stats_hero_label" long_mode="dots" style_text_color="#text_muted"
                    clickable="false" event_bubble="true"/>
      </lv_obj>

      <lv_obj name="ps_bars"
              width="100%" height="100%" flex_grow="1" flex_flow="row" style_flex_main_place="space_between"
              style_flex_cross_place="end" style_pad_all="0" style_bg_opa="0" style_border_width="0" scrollable="false"
              clickable="false" event_bubble="true">
        <bind_flag_if_not_eq subject="print_stats_show_bars" flag="hidden" ref_value="1"/>
        <repeat count="7">
          <lv_obj name="ps_day_${i}"
                  width="#space_xs" height="100%" flex_flow="column" style_flex_cross_place="center" style_pad_all="0"
                  style_pad_row="0" style_bg_opa="0" style_border_width="0" scrollable="false" clickable="false"
                  event_bubble="true">
            <lv_bar name="ps_bar_${i}"
                    width="100%" flex_grow="1" orientation="vertical" min_value="0" max_value="100"
                    bind_value="print_stats_day_${i}" style_bg_color="#text_muted" style_bg_opa="40"
                    style_bg_color-indicator="#primary" style_bg_opa-indicator="255" style_radius="#border_radius"
                    style_radius-indicator="#border_radius" clickable="false" event_bubble="true"/>
            <text_tiny name="ps_day_label_${i}"
                       bind_text="print_stats_day_label_${i}" style_text_color="#text_muted" clickable="false"
                       event_bubble="true">
              <bind_flag_if_not_eq subject="print_stats_show_day_labels" flag="hidden" ref_value="1"/>
            </text_tiny>
          </lv_obj>
        </repeat>
      </lv_obj>
    </lv_obj>

    <text_small name="ps_support"
                width="100%" bind_text="print_stats_support_text" long_mode="dots" style_text_color="#text_muted"
                clickable="false" event_bubble="true">
      <bind_flag_if_eq subject="print_stats_support" flag="hidden" ref_value="0"/>
    </text_small>
  </view>
</component>
